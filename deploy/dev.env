# LOCAL TESTING ONLY, used with docker-compose.dev.yml (--env-file dev.env). Every value is a throwaway
# value for the mock sign-in provider on a laptop; none of them is valid anywhere else.
# Production uses deploy/.env, made from .env.example.
DOMAIN=:80
CA_EDGE_SUBNET=172.29.248.0/24
POSTGRES_PASSWORD=dev-only-postgres-password
SESSION_SECRET=dev-only-session-secret-for-the-local-stack-0123456789
OIDC_ISSUER=http://idp.localhost:8101
OIDC_CLIENT_ID=ca-dev-mock-client
OIDC_CLIENT_SECRET=dev-only-mock-client-secret
OIDC_PROVIDER_NAME=Mock SSO
APP_ADMIN_EMAILS=
# Host port of the dev Postgres (default 55433; Windows may reserve it, then pick another free port):
# CA_DEV_DB_PORT=55433
